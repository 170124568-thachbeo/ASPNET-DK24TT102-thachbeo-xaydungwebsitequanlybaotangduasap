@model QuanLyBaoTangDuaSap.Models.HienVat

@{
    ViewData["Title"] = "Chi Tiết Hiện Vật";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Chi Tiết Hiện Vật Bảo Tàng</h2>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="card-title mb-0">Thông tin lưu trữ chi tiết</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold mb-3">Tên Hiện Vật:</dt>
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.TenHienVat)</dd>

                <dt class="col-sm-3 fw-bold mb-3">Mô Tả:</dt>
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.MoTa)</dd>

                <dt class="col-sm-3 fw-bold mb-3">Ngày Tiếp Nhận:</dt>
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.NgayTiepNhan)</dd>

                <dt class="col-sm-3 fw-bold mb-3">Số Lượng:</dt>
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.SoLuong)</dd>

                <dt class="col-sm-3 fw-bold mb-3">Danh Mục:</dt>
                <dd class="col-sm-9 mb-3">@Model.DanhMuc?.TenDanhMuc</dd>

                <dt class="col-sm-3 fw-bold mb-3">Mã Danh Mục:</dt>
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.MaDanhMuc)</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a href="/HienVats/Edit?id=@Model?.MaHienVat" class="btn btn-warning">Chỉnh sửa</a>
        <a href="/HienVats" class="btn btn-secondary ms-2">Quay lại danh sách</a>
    </div>
</div>