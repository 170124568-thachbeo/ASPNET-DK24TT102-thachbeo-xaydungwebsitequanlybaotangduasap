@model QuanLyBaoTangDuaSap.Models.HienVat

@{
    ViewData["Title"] = "Xóa Hiện Vật";
}

<div class="container mt-4">
    <h2 class="text-danger mb-3">Xóa Hiện Vật Khỏi Hệ Thống</h2>

    <div class="alert alert-warning shadow-sm" role="alert">
        <h4 class="alert-heading fw-bold">⚠️ Cảnh báo nguy hiểm!</h4>
        <p class="mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn hiện vật này không? Hành động này không thể hoàn tác sau khi thực hiện.</p>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold mb-2">Tên Hiện Vật:</dt>
                <dd class="col-sm-9 mb-2">@Html.DisplayFor(model => model.TenHienVat)</dd>

                <dt class="col-sm-3 fw-bold mb-2">Mô Tả:</dt>
                <dd class="col-sm-9 mb-2">@Html.DisplayFor(model => model.MoTa)</dd>

                <dt class="col-sm-3 fw-bold mb-2">Số Lượng:</dt>
                <dd class="col-sm-9 mb-2">@Html.DisplayFor(model => model.SoLuong)</dd>

                <dt class="col-sm-3 fw-bold mb-2">Danh Mục:</dt>
                <dd class="col-sm-9 mb-2">@Model.DanhMuc?.TenDanhMuc</dd>
            </dl>
        </div>
    </div>

    <!-- Form gửi lệnh xóa về Controller -->
    <form asp-controller="HienVats" asp-action="XoaHienVatThucSu" method="post" class="mt-3">
        <input type="hidden" name="MaHienVat" value="@Model.MaHienVat" />
        <input type="submit" value="Xác nhận Xóa" class="btn btn-danger shadow-sm" />
        <a href="/HienVats" class="btn btn-secondary ms-2">Hủy bỏ và Quay lại</a>
    </form>
</div>
